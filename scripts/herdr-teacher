#!/bin/sh
skill_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P) || exit 2

if [ -z "${HERDR_TEACHER_SKILL_DIR:-}" ]; then
  export HERDR_TEACHER_SKILL_DIR="$skill_dir"
fi

if [ -n "${HERDR_TEACHER_BIN:-}" ]; then
  if [ -x "$HERDR_TEACHER_BIN" ]; then
    exec "$HERDR_TEACHER_BIN" "$@"
  fi
  echo "herdr-teacher: HERDR_TEACHER_BIN is not executable: $HERDR_TEACHER_BIN" >&2
  exit 2
fi

case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*)
    bin="$skill_dir/bin/herdr-teacher.exe"
    ;;
  *)
    bin="$skill_dir/bin/herdr-teacher"
    ;;
esac

if command -v go >/dev/null 2>&1; then
  needs_build=0
  if [ ! -f "$bin" ]; then
    needs_build=1
  elif [ -n "$(find "$skill_dir/cmd" "$skill_dir/internal" "$skill_dir/go.mod" -newer "$bin" 2>/dev/null)" ]; then
    needs_build=1
  fi
  if [ "$needs_build" -eq 1 ]; then
    (cd "$skill_dir" && go build -o "$bin" ./cmd/herdr-teacher) || exit 2
  fi
elif [ ! -f "$bin" ]; then
  echo "herdr-teacher: Go 1.25+ is required to build bin/herdr-teacher (or set HERDR_TEACHER_BIN)" >&2
  exit 2
fi

exec "$bin" "$@"
